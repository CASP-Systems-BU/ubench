# Copy to `.env` and fill in your OpenRouter key. The `.env` is gitignored — never
# commit the key. Any `wintermute`/redteam-agent flag can be set here as key=value
# (CLI flags override the .env).

# --- LLM: OpenRouter via litellm --------------------------------------------
# Get a key at https://openrouter.ai/keys
llm.api_key='sk-or-...'
# Model in litellm/OpenRouter format. Swap freely, e.g.:
#   openrouter/anthropic/claude-3.7-sonnet
#   openrouter/openai/gpt-4o
llm.model='openrouter/anthropic/claude-3.5-sonnet'
llm.api_base='https://openrouter.ai/api'
llm.context_size=200000

# --- Run limits (bound cost/length of the assessment) -----------------------
limits.max_rounds=40
limits.max_cost=5.0

# --- Target (the compromised pod + how to reach it) -------------------------
# These are normally passed on the CLI by scripts/cloudlab/redteam.sh, which
# knows the live pod name and control host; set them here only for manual runs.
#pod='redteam-agent-xxxxxxxxx-yyyyy'
#node0='apt097.apt.emulab.net'
#node0_user='yuhang'
#namespace='redteam'
#container='agent'
#cmd_timeout=60
